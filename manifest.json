{
  "manifest_version": 3,
  "name": "Hover File Preview",
  "version": "1.0.0",
  "description": "Hover an image, PDF, text, spreadsheet or Office link to preview it without downloading the file.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hover-file-preview@phonezm.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/zip.js",
        "src/lib.js",
        "dist/pptx.js",
        "src/docx.js",
        "src/xlsx.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/PhonezM/hover-file-preview"
}
