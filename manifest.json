{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "hover-file-preview@phonezm.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/zip.js",
        "src/lib.js",
        "src/docx.js",
        "src/xlsx.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/PhonezM/hover-file-preview"
}
