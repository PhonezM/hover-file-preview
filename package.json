{
  "name": "hover-file-preview",
  "version": "1.0.2",
  "private": true,
  "description": "Firefox/Zen and Chrome extension: hover previews for images, PDF, text, spreadsheets, Word and PowerPoint links.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhonezM/hover-file-preview.git"
  },
  "author": "PhonezM",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "./build.sh",
    "build:renderer": "./build-renderer.sh",
    "test": "node --test tests/lib.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "lint": "npx --yes web-ext@10 lint --source-dir build/firefox",
    "size": "node scripts/check-size.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
